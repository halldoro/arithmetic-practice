           RowBox[{"ImageSize", "->", "80"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"pure", " ", "empty", " ", "space", " ", "below"}], "\[LongDash]", 
          RowBox[{"no", " ", "frame"}], ",", 
          RowBox[{"no", " ", "axes"}], ",", 
          RowBox[{"just", " ", "reserved", " ", "height"}]}], "*)"}], 
        RowBox[{"space", "=", 
         RowBox[{"Pane", "[", 
          RowBox[{
           RowBox[{"Spacer", "[", "0", "]"}], ",", 
           RowBox[{"ImageSize", "->", 
            RowBox[{"{", 
             RowBox[{"Automatic", ",", "writeHeight"}], "}"}]}]}], "]"}]}], ";",
