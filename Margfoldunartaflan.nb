            RowBox[{"Spacings", "->", "0"}]}], "]"}], ",", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{
            "n", ",", "\"\< \[Times] \>\"", ",", "m", ",", "\"\< = \>\"", ",",
              "k"}], "}"}], "]"}]}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Build"}]}], " ", "the", " ", "10", "\[Times]", "10", " ",
       "grid", " ", "with", " ", 
      RowBox[{"headers", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cells", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"mulCell", "[", 
