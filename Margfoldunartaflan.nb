      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"#", ",", "Bold", ",", "14", ",", 
         RowBox[{"GrayLevel", "[", ".25", "]"}]}], "]"}], "&"}], "/@", 
      RowBox[{"Range", "[", "10", "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"table", "=", 
     RowBox[{"Grid", "[", 
