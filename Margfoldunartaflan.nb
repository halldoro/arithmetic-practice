Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Define"}]}], " ", "a", " ", "function", " ", "for", " ", 
     "one", " ", "multiplication", " ", 
     RowBox[{"cell", "--"}]}], "-"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "mulCell", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"mulCell", "[", 
      RowBox[{
       RowBox[{"n_Integer", "?", "Positive"}], ",", 
       RowBox[{"m_Integer", "?", "Positive"}], ",", 
       RowBox[{"boxSize_", ":", "0.08"}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "side", " ", "length", " ", "of", " ", "each", " ", "small", " ", 
          "square"}], ",", 
         RowBox[{"constant", " ", "across", " ", "all", " ", "cells"}]}], 
        "*)"}], 
       RowBox[{"gap_", ":", "0.02"}], ",", 
       RowBox[{"(*", 
        RowBox[{"gap", " ", "between", " ", "small", " ", "squares"}], "*)"}], 
       RowBox[{"writeHeight_", ":", "24"}]}], "  ", 
      RowBox[{"(*", 
       RowBox[{
       "pixel", " ", "height", " ", "of", " ", "empty", " ", "writing", " ", 
        "space", " ", "below", " ", "the", " ", "grid"}], "*)"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"k", "=", 
          RowBox[{"n", "*", "m"}]}], ",", "color", ",", "width", ",", 
         "height", ",", "startX", ",", "startY", ",", "grid", ",", "space"}], 
        "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{"color", " ", "by", " ", "number", " ", "type"}], "*)"}], 
       RowBox[{
        RowBox[{"color", "=", 
         RowBox[{"Which", "[", 
          RowBox[{
           RowBox[{"PrimeQ", "[", "k", "]"}], ",", "Pink", ",", 
           RowBox[{"IntegerQ", "[", 
            RowBox[{"Sqrt", "[", "k", "]"}], "]"}], ",", "Blue", ",", "True", 
           ",", "Black"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "geometry", " ", "of", " ", "the", " ", "n", "\[Times]", "m", " ", 
           "mini"}], "-", "grid"}], "*)"}], 
        RowBox[{"width", "=", 
         RowBox[{
          RowBox[{"n", " ", 
           RowBox[{"(", 
            RowBox[{"boxSize", "+", "gap"}], ")"}]}], "-", "gap"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"height", "=", 
         RowBox[{
          RowBox[{"m", " ", 
           RowBox[{"(", 
            RowBox[{"boxSize", "+", "gap"}], ")"}]}], "-", "gap"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"startX", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "width"}], ")"}], "/", "2"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"startY", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "height"}], ")"}], "/", "2"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"the", " ", "mini"}], "-", 
          RowBox[{"grid", " ", "of", " ", "equal"}], "-", 
          RowBox[{"sized", " ", "separated", " ", "squares"}]}], "*)"}], 
        RowBox[{"grid", "=", 
         RowBox[{"Graphics", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"EdgeForm", "[", "None", "]"}], ",", "color", ",", 
             RowBox[{
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"With", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"x", "=", 
                    RowBox[{"startX", "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"i", "-", "1"}], ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"boxSize", "+", "gap"}], ")"}]}]}]}], ",", 
                    RowBox[{"y", "=", 
                    RowBox[{"startY", "+", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"j", "-", "1"}], ")"}], " ", 
                    RowBox[{"(", 
                    RowBox[{"boxSize", "+", "gap"}], ")"}]}]}]}]}], "}"}], ",", 
                  RowBox[{"Rectangle", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"x", ",", "y"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"x", "+", "boxSize"}], ",", 
                    RowBox[{"y", "+", "boxSize"}]}], "}"}]}], "]"}]}], "]"}], 
                ",", 
                RowBox[{"{", 
                 RowBox[{"j", ",", "m"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "n"}], "}"}]}], "]"}], "//", "Flatten"}]}],
             "}"}], ",", 
           RowBox[{"PlotRange", "->", 
            RowBox[{"{", 
