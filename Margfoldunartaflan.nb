        RowBox[{"m", ",", "1", ",", "10"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", "10"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hdr", "=", 
