         RowBox[{"Prepend", "[", 
          RowBox[{"hdr", ",", "\"\<\>\""}], "]"}]}], "]"}], ",", 
       RowBox[{"Spacings", "->", 
        RowBox[{"{", 
         RowBox[{"0.5", ",", "1"}], "}"}]}], ",", 
       RowBox[{"(*", 
